#!/bin/sh
set -eu
[ -d /run/live/medium ] || exit 0
[ ! -e /run/jiukong-live-password ] || exit 0
id jiukong >/dev/null
password=$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')
printf 'jiukong:%s\n' "$password" | chpasswd
# Remove Debian Live's passwordless sudo rule, including other common filenames.
for f in /etc/sudoers.d/*; do
    [ -f "$f" ] || continue
    if grep -q 'NOPASSWD' "$f" && grep -Eq 'live|jiukong' "$f"; then rm "$f"; fi
done
printf 'jiukong ALL=(ALL:ALL) ALL\n' > /etc/sudoers.d/live
chmod 440 /etc/sudoers.d/live
# Debian Live otherwise grants all active local sudo users unprompted polkit.
rm -f /usr/share/polkit-1/rules.d/sudo_on_live.rules
umask 077
printf 'Live 使用者：jiukong\n本次開機的鎖定及 sudo 密碼：%s\n重開機後變更；SSD 安裝帳號由 Debian Installer 建立。\n' "$password" > /run/jiukong-live-password
chown jiukong:jiukong /run/jiukong-live-password
visudo -c
